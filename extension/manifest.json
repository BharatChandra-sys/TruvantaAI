{
  "manifest_version": 3,
  "name": "TruvantaAI",
  "version": "2.6.4",
  "description": "TruvantaAI — Real-time fake news detection powered by AI",
  "key": "",

  "permissions": [
    "storage",
    "contextMenus",
    "identity",
    "windows",
    "alarms",
    "notifications",
    "sidePanel"
  ],

  "commands": {
    "open-factchecker": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open TruvantaAI popup"
    },
    "analyze-selected-text": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Fact-check selected text on the current page"
    },
    "analyze-current-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Fact-check visible text from the current page"
    }
  },

  "oauth2": {
    "client_id": "595122585703-6v7d8602emobounkv3k93fbagih73k7s.apps.googleusercontent.com",
    "scopes": ["openid", "email", "profile"]
  },

  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://factcheckai-coq3.onrender.com/*",
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],

  "content_security_policy": {
    "extension_pages": "default-src 'self'; media-src 'self' blob: mediastream:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https: data:; connect-src 'self' http://127.0.0.1:8000 http://localhost:8000 ws://127.0.0.1:8000 ws://localhost:8000 https://factcheckai-coq3.onrender.com wss://factcheckai-coq3.onrender.com https://www.googleapis.com https://oauth2.googleapis.com https://accounts.google.com"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "TruvantaAI — Fact Checker"
  },

  "side_panel": {
    "default_path": "popup/popup.html"
  },

  "background": {
    "service_worker": "background/service_worker.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
